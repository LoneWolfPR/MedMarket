# Template for the gitignored .env that feeds the staging secretGenerator.
# Copy to `.env` in this directory and fill real values; NEVER commit .env.
#
#   cp .env.example .env
#
# The password embedded in DATABASE_URL MUST match POSTGRES_PASSWORD.

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://medmarket:change-me@postgres:5432/medmarket?sslmode=disable
JWT_SECRET=change-me-long-random
STRIPE_SECRET_KEY=sk_test_xxx
PHARMACY_A_SECRET=pharmacy-a-key
PHARMACY_B_SECRET=pharmacy-b-token
